<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiExamples.Models"
             x:Class="MauiExamples.Examples.MVU.ProductsPages"
             Title="ProductsPages">
    <VerticalStackLayout>
        <SearchBar
            x:Name="SearchBar"
            Placeholder="Search products..."
            TextChanged="OnSearchTextChanged"/>

        <!-- CollectionView is named so Render() can set ItemsSource on it. -->
        <CollectionView x:Name="ProductList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>