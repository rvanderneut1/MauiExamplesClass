<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiExamples.Examples.Basics.BasicPage"
             Title="BasicPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Margin="20" Spacing="30">

            <!-- 1. VerticalStackLayout -->
            <Border Stroke="{StaticResource PrimaryBorder}" StrokeThickness="4" Padding="10" Style="{StaticResource CardStyle}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">

                    <Label Text="1. VerticalStackLayout" FontAttributes="Bold" FontSize="18">
                        <Label.FontSize>
                            <OnPlatform x:TypeArguments="x:Double">
                                <On Platform="iOS" Value="20"/>
                                <On Platform="Android" Value="18"/>
                            </OnPlatform>
                        </Label.FontSize>
                    </Label>
                    <BoxView Color="DodgerBlue" HeightRequest="100" CornerRadius="5"/>
                    <Label Text="Hero Title" FontSize="20" FontAttributes="Bold"/>
                    <Label Text="This is a hero element using VerticalStackLayout. Items stack vertically from top to bottom."/>
                    <Button Text="Learn More" BackgroundColor="DodgerBlue" TextColor="White"/>
                </VerticalStackLayout>
            </Border>

            <!-- 2. HorizontalStackLayout -->
            <Frame BorderColor="Green" Padding="10" CornerRadius="{StaticResource CardCornerRadius}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="2. HorizontalStackLayout" FontAttributes="Bold" FontSize="18"/>
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Color="Green" WidthRequest="100" HeightRequest="100" CornerRadius="5"/>
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Hero Title" FontSize="16" FontAttributes="Bold"/>
                            <Label Text="Items arranged horizontally side-by-side."/>
                            <Button Text="Learn More" BackgroundColor="Green" TextColor="White"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- 3. Grid -->
            <Frame BorderColor="Orange" Padding="10" CornerRadius="30">
                <VerticalStackLayout Spacing="10">
                    <Label Text="3. Grid" FontAttributes="Bold" FontSize="18"/>
                    <Grid RowDefinitions="100,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                        <BoxView Grid.Row="0" Grid.ColumnSpan="2" Color="Orange" CornerRadius="5"/>
                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="Hero Title" FontSize="20" FontAttributes="Bold"/>
                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="Grid layout allows precise positioning with rows and columns."/>
                        <Button Grid.Row="3" Grid.Column="0" Text="Action 1" BackgroundColor="Orange" TextColor="White"/>
                        <Button Grid.Row="3" Grid.Column="1" Text="Action 2" BackgroundColor="DarkOrange" TextColor="White"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- 4. FlexLayout -->
            <Frame BorderColor="Purple" Padding="10" CornerRadius="8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="4. FlexLayout" FontAttributes="Bold" FontSize="18"/>
                    <FlexLayout Direction="Row" JustifyContent="End" AlignItems="Center">
                        <BoxView Color="Purple" HeightRequest="500" CornerRadius="5"/>
                        <Label Text="Hero Title" FontSize="20" FontAttributes="Bold" Margin="0,10,0,5"/>
                        <Label Text="FlexLayout provides flexible box layout with wrapping and alignment options."/>
                        <FlexLayout Direction="Row" JustifyContent="SpaceBetween" Margin="0,10,0,0">
                            <Button Text="Share" BackgroundColor="Purple" TextColor="White" FlexLayout.Grow="1" Margin="0,0,5,0"/>
                            <Button Text="Save" BackgroundColor="MediumPurple" TextColor="White" FlexLayout.Grow="1" Margin="5,0,0,0"/>
                        </FlexLayout>
                    </FlexLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="Red" Padding="10" CornerRadius="8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="5. AbsoluteLayout" FontAttributes="Bold" FontSize="18"/>
                    <AbsoluteLayout HeightRequest="250">
                        <!-- Background Image -->
                        <BoxView Color="Crimson" CornerRadius="5"
                        AbsoluteLayout.LayoutBounds="0,0,1,0.4"
                        AbsoluteLayout.LayoutFlags="All"/>

                        <!-- Overlay Badge -->
                        <Frame BackgroundColor="White" Padding="10" CornerRadius="20" HasShadow="True"
                      AbsoluteLayout.LayoutBounds="0.9,0.05,60,60"
                      AbsoluteLayout.LayoutFlags="PositionProportional">
                            <Label Text="NEW" FontSize="10" FontAttributes="Bold" TextColor="Red" 
                          HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>

                        <!-- Title positioned absolutely -->
                        <Label Text="Hero Title" FontSize="20" FontAttributes="Bold" TextColor="White"
                      AbsoluteLayout.LayoutBounds="20,60,200,30"
                      AbsoluteLayout.LayoutFlags="None"/>

                        <!-- Description -->
                        <Label Text="AbsoluteLayout allows precise pixel or proportional positioning." 
                      FontSize="12" TextColor="White"
                      AbsoluteLayout.LayoutBounds="20,95,250,60"
                      AbsoluteLayout.LayoutFlags="None"/>

                        <!-- Button positioned at bottom -->
                        <Button Text="Learn More" BackgroundColor="DarkRed" TextColor="White"
                       AbsoluteLayout.LayoutBounds="0.5,1,150,40"
                       AbsoluteLayout.LayoutFlags="PositionProportional"/>
                    </AbsoluteLayout>
                </VerticalStackLayout>
            </Frame>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>